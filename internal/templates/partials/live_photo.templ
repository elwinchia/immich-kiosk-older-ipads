package partials

import (
	"fmt"
	"net/url"
)

// boomerang (fork): the clip already runs forward then backward, so a single looping video
// replaces the top/bottom pair, whose fade at every end showed the photo between loops.
// It stays faded out and paused; live-photo.ts starts it after the photo has shown for a second.
templ LivePhoto(videoID, videoMimeType, videoOrientation, password string, boomerang bool) {
	if boomerang {
		<video
			data-live-photo
			data-live-photo-boomerang
			data-group={ fmt.Sprintf("live-photo-%s", videoID) }
			class={ "frame--video--"+videoOrientation, "live-photo", "live-photo-fade" }
			muted
			loop
			preload="auto"
			playsinline
			webkit-playsinline
			x-webkit-airplay="allow"
		>
			<source
				if password != "" {
					src={ fmt.Sprintf("/video/%s?password=%s", videoID, url.QueryEscape(password)) }
				} else {
					src={ fmt.Sprintf("/video/%s", videoID) }
				}
				if videoMimeType != "" {
					type={ videoMimeType }
				}
			/>
		</video>
	} else {
		<video
			data-live-photo
			data-group={ fmt.Sprintf("live-photo-%s", videoID) }
			data-live-photo-role="bottom"
			class={ "frame--video--"+videoOrientation, "live-photo", "live-photo-bottom" }
			muted
			playsinline
			webkit-playsinline
			x-webkit-airplay="allow"
		>
			<source
				if password != "" {
					src={ fmt.Sprintf("/video/%s?password=%s", videoID, url.QueryEscape(password)) }
				} else {
					src={ fmt.Sprintf("/video/%s", videoID) }
				}
				if videoMimeType != "" {
					type={ videoMimeType }
				}
			/>
		</video>
		<video
			data-live-photo
			data-group={ fmt.Sprintf("live-photo-%s", videoID) }
			data-live-photo-role="top"
			class={ "frame--video--"+videoOrientation, "live-photo", "live-photo-top" }
			autoplay
			muted
			playsinline
			webkit-playsinline
			x-webkit-airplay="allow"
			hx-on::load="this.play()"
		>
			<source
				if password != "" {
					src={ fmt.Sprintf("/video/%s?password=%s", videoID, url.QueryEscape(password)) }
				} else {
					src={ fmt.Sprintf("/video/%s", videoID) }
				}
				if videoMimeType != "" {
					type={ videoMimeType }
				}
			/>
		</video>
	}
}
